# Copy to .env and adjust. Never commit .env.
# Later phases add their own keys here (price feed, calendar, AI digest, SMTP, login).

TRADEPILOT_SYMBOL=XAUUSD
TRADEPILOT_SIGNAL_TIMEFRAME=M15

# A signal needs at least this many closed candles (EMA200 warm-up).
TRADEPILOT_MIN_BARS=300

# A price older than this many seconds counts as stale (used from Phase 5).
TRADEPILOT_STALE_AFTER_SECONDS=60
