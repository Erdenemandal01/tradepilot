# Copy to .env and adjust. Never commit .env.
# Later phases add their own keys here (price feed, calendar, AI digest, SMTP, login).

TRADEPILOT_SYMBOL=XAUUSD
TRADEPILOT_SIGNAL_TIMEFRAME=M15

# A signal needs at least this many closed candles (EMA200 warm-up).
TRADEPILOT_MIN_BARS=300

# A price older than this many seconds counts as stale (used from Phase 5).
TRADEPILOT_STALE_AFTER_SECONDS=60

# Price source (Phase 3): binance (default, no key), twelvedata or csv.
TRADEPILOT_PRICE_SOURCE=binance
TRADEPILOT_BINANCE_SYMBOL=XAUUSDT
TRADEPILOT_TWELVEDATA_SYMBOL=XAU/USD
# Free key from twelvedata.com. Secret: only in .env, never in git.
TRADEPILOT_TWELVEDATA_API_KEY=
TRADEPILOT_CSV_PATH=data/xauusd_m15.csv
TRADEPILOT_CSV_TIMEFRAME=M15

# --- Web app (live feed, login, email) ---

# How often the price source is asked, in seconds, and how many M15 candles stay in memory.
TRADEPILOT_POLL_SECONDS=2
TRADEPILOT_HISTORY_CANDLES=1500
# A silent feed is emailed about after this many seconds (the page shows it after STALE_AFTER_SECONDS).
TRADEPILOT_ALERT_AFTER_SECONDS=300
# Times in emails: hours ahead of UTC (8 = Ulaanbaatar).
TRADEPILOT_DISPLAY_UTC_OFFSET_HOURS=8

# The forecast model (next four M15 closes). Written by  python -m backend.scripts.train_forecast
# The web app reads it at start-up; without the file no forecast is shown.
TRADEPILOT_FORECAST_MODEL_PATH=data/forecast_model.json

# Login. Do not type these by hand: run  python -m backend.scripts.set_password
# It writes the password's hash and a session secret here. Secret: only in .env.
TRADEPILOT_PASSWORD_HASH=
TRADEPILOT_SESSION_SECRET=
TRADEPILOT_SESSION_HOURS=12
# Set to true once the site is served over HTTPS (Phase 9).
TRADEPILOT_COOKIE_SECURE=false

# Email (SMTP). Leave the host or the recipients empty and no email is sent.
# Gmail: host smtp.gmail.com, port 587, user = the sending address, password = an app password
# (needs 2-Step Verification on that account). Secret: only in .env.
TRADEPILOT_SMTP_HOST=
TRADEPILOT_SMTP_PORT=587
TRADEPILOT_SMTP_USER=
TRADEPILOT_SMTP_PASSWORD=
TRADEPILOT_EMAIL_FROM=
# Comma-separated addresses that receive signals and system alerts.
TRADEPILOT_EMAIL_TO=
